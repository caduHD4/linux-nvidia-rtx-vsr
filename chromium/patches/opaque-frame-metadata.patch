diff --git a/media/gpu/chromeos/mailbox_video_frame_converter_unittest.cc b/media/gpu/chromeos/mailbox_video_frame_converter_unittest.cc
index c9345190d7..2e107349e2 100644
--- a/media/gpu/chromeos/mailbox_video_frame_converter_unittest.cc
+++ b/media/gpu/chromeos/mailbox_video_frame_converter_unittest.cc
@@ -234,6 +234,56 @@ class MailboxVideoFrameConverterTest : public ::testing::Test {
   std::unique_ptr<FrameResourceConverter> converter_;
 };
 
+TEST_F(MailboxVideoFrameConverterTest,
+       OpaqueArgbDecoderFrameCreatesOpaqueSharedImage) {
+  auto input_sii = base::MakeRefCounted<gpu::TestSharedImageInterface>();
+  auto mock_sii = base::MakeRefCounted<StrictMock<MockSharedImageInterface>>();
+  mock_shared_image_interface_ = mock_sii.get();
+  converter_ = MailboxVideoFrameConverter::Create(mock_sii);
+  converter_->Initialize(base::SingleThreadTaskRunner::GetCurrentDefault(),
+                         mock_output_cb_.Get());
+
+  const gfx::Size size(640, 368);
+  const gfx::Rect rect(size);
+  const gfx::ColorSpace color_space = gfx::ColorSpace::CreateREC709();
+  const auto format = viz::SinglePlaneFormat::kBGRA_8888;
+  auto input_image = input_sii->CreateSharedImage(
+      {format, size, color_space,
+       gpu::SHARED_IMAGE_USAGE_CPU_WRITE_ONLY |
+           gpu::SHARED_IMAGE_USAGE_DISPLAY_READ,
+       "OpaqueArgbDecoderFrame"},
+      gpu::kNullSurfaceHandle, gfx::BufferUsage::GPU_READ,
+      CreatePixmapHandle(size, format));
+  ASSERT_TRUE(input_image);
+  auto input_frame = VideoFrame::WrapMappableSharedImage(
+      input_image, input_sii->GenVerifiedSyncToken(), base::NullCallback(),
+      rect, size, base::TimeDelta());
+  ASSERT_TRUE(input_frame);
+  auto frame_resource = VideoFrameResource::Create(input_frame);
+  ASSERT_TRUE(frame_resource);
+  auto wrapped_frame = frame_resource->CreateWrappingFrame();
+  ASSERT_TRUE(wrapped_frame);
+  // The decoder marks each output wrapper opaque. The reusable pool resource
+  // itself intentionally retains default metadata between frames.
+  wrapped_frame->metadata().alpha_is_opaque = true;
+
+  EXPECT_CALL(*mock_sii,
+              CreateSharedImage(_, Matcher<gfx::GpuMemoryBufferHandle>(_)))
+      .WillOnce([&](const gpu::SharedImageInfo& info,
+                    gfx::GpuMemoryBufferHandle handle) {
+        EXPECT_EQ(info.format, format);
+        EXPECT_EQ(info.alpha_type, kOpaque_SkAlphaType);
+        return base::MakeRefCounted<gpu::ClientSharedImage>(
+            gpu::Mailbox::Generate(), info, gpu::SyncToken(), mock_sii->holder(),
+            handle.type);
+      });
+  auto converted_image =
+      static_cast<MailboxVideoFrameConverter*>(converter_.get())
+          ->GenerateSharedImage(frame_resource.get(), wrapped_frame);
+  EXPECT_TRUE(converted_image);
+  EXPECT_EQ(converted_image->alpha_type(), kOpaque_SkAlphaType);
+}
