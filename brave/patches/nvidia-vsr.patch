+uint64_t VideoFrameCompositor::NvidiaVsrFullscreenEpoch() const {
+  return nvidia_vsr_fullscreen_epoch_.load(std::memory_order_relaxed);
+}
+
+void VideoFrameCompositor::PaintNvidiaVsrOriginal(
+    scoped_refptr<media::VideoFrame> original,uint64_t enhanced_id,uint64_t epoch) {
+  if(!task_runner_->BelongsToCurrentThread()) {
+    PostCrossThreadTask(*task_runner_,FROM_HERE,CrossThreadBindOnce(
+        &VideoFrameCompositor::PaintNvidiaVsrOriginal,
+        weak_ptr_factory_.GetWeakPtr(),std::move(original),enhanced_id,epoch));
+    return;
+  }
+  {
+    base::AutoLock lock(current_frame_lock_);
+    if(!current_frame_ ||
+       current_frame_->unique_id().GetUnsafeValue()!=enhanced_id) return;
+  }
+  // All frame installation happens on this sequence. The expected ID prevents
+  // replacing a newer frame. Restore this old enhanced frame even if fullscreen
+  // changed again while the notification was queued (including paused playback).
+  PaintSingleFrame(std::move(original),true);
+}
+
+void VideoFrameCompositor::SetNvidiaVsrFullscreenCallback(
+    base::RepeatingClosure callback) {
+  base::AutoLock lock(nvidia_vsr_fullscreen_lock_);
+  nvidia_vsr_fullscreen_changed_=std::move(callback);
+}
+
+void VideoFrameCompositor::SetNvidiaVsrFullscreen(bool fullscreen) {
+  const auto epoch=nvidia_vsr_fullscreen_epoch_.load(std::memory_order_relaxed);
+  if(static_cast<bool>(epoch & 1)==fullscreen) return;
+  nvidia_vsr_fullscreen_epoch_.store(epoch+1,std::memory_order_relaxed);
+  base::RepeatingClosure changed;
+  {base::AutoLock lock(nvidia_vsr_fullscreen_lock_);
+   changed=nvidia_vsr_fullscreen_changed_;}
+  if(changed) changed.Run();
+}
