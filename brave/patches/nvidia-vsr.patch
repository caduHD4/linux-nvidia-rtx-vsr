+void GpuChannel::CreateNvidiaVsr(
+    int32_t source_route, int32_t output_route,
+    mojo::PendingReceiver<mojom::NvidiaVsr> receiver,
+    mojom::GpuChannel::CreateNvidiaVsrCallback callback) {
+#if BUILDFLAG(ENABLE_NVIDIA_VSR)
+  if (source_route <= 0 || output_route <= 0 || source_route == output_route ||
+      LookupCommandBuffer(source_route) || LookupCommandBuffer(output_route) ||
+      sync_point_manager_->GetSyncTokenReleaseSequenceId(SyncToken(
+          CommandBufferNamespace::GPU_IO,
+          CommandBufferIdFromChannelAndRoute(client_id(), source_route), 1)) ||
+      sync_point_manager_->GetSyncTokenReleaseSequenceId(SyncToken(
+          CommandBufferNamespace::GPU_IO,
+          CommandBufferIdFromChannelAndRoute(client_id(), output_route), 1))) {
+    std::move(callback).Run(false);
+    return;
+  }
+  auto service = base::MakeRefCounted<NvidiaVsrGpuService>(
+      this, source_route, output_route, std::move(receiver));
+  const bool available = service->Initialize();
+  if (available) {
+    nvidia_vsr_services_.push_back(std::move(service));
+  }
+  std::move(callback).Run(available);
+#else
+  std::move(callback).Run(false);
+#endif
+}
