+// static
+bool CompoundImageBacking::IsNativeGpuBacking(
+    const SharedImageBacking* backing) {
+  if (!backing || backing->usage().Has(SHARED_IMAGE_USAGE_CPU_ONLY_READ_WRITE))
+    return false;
+  const auto type = backing->GetType();
+  return type == SharedImageBackingType::kGLTexture ||
+         type == SharedImageBackingType::kEGLImage ||
+         type == SharedImageBackingType::kOzone;
+}
+
+SharedImageBacking* CompoundImageBacking::GetExistingGpuOnlyBacking(
+    SharedImageAccessStream stream,
+    const AccessParams& params) {
+  AutoLock auto_lock(this);
+  // Reject mixed/CPU/lazy backings even when a GPU child happens to be current.
+  if (elements_.size() != 1u)
+    return nullptr;
+  auto& element = elements_.front();
+  auto* child = element.backing.get();
+  if (!IsNativeGpuBacking(child) || element.create_callback ||
+      element.content_id_ != latest_content_id_ ||
+      !element.access_streams.Has(stream) ||
+      !child->SupportsAccess(stream, params)) {
+    return nullptr;
+  }
+  return child;
+}
+
+std::unique_ptr<GLTextureImageRepresentation>
+CompoundImageBacking::ProduceGLTextureGpuOnly(SharedImageManager* manager,
+                                              MemoryTypeTracker* tracker) {
+  auto* child =
+      GetExistingGpuOnlyBacking(SharedImageAccessStream::kGL, AccessParams());
+  if (!child)
+    return nullptr;
+  auto rep = child->ProduceGLTexture(manager, tracker);
+  if (!rep)
+    return nullptr;
+  return std::make_unique<WrappedGLTextureCompoundImageRepresentation>(
+      manager, this, tracker, std::move(rep), nullptr, true);
+}
+
+std::unique_ptr<SkiaGaneshImageRepresentation>
+CompoundImageBacking::ProduceSkiaGaneshGpuOnly(
+    SharedImageManager* manager,
+    MemoryTypeTracker* tracker,
+    scoped_refptr<SharedContextState> context_state) {
+  if (!context_state || !context_state->GrContextIsGL())
+    return nullptr;
+  AccessParams params;
+  params.context_state = context_state;
+  auto* child =
+      GetExistingGpuOnlyBacking(SharedImageAccessStream::kSkia, params);
+  if (!child)
+    return nullptr;
+  auto rep = child->ProduceSkiaGanesh(manager, tracker, context_state);
+  if (!rep)
+    return nullptr;
+  return std::make_unique<WrappedSkiaGaneshCompoundImageRepresentation>(
+      context_state->gr_context(), manager, this, tracker, std::move(rep),
+      nullptr, true);
+}
