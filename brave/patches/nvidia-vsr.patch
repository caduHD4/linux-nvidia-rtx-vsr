+scoped_refptr<VideoFrame> VideoRendererImpl::SelectNvidiaVsrFrame_Locked(
+    scoped_refptr<VideoFrame> original) {
+  lock_.AssertAcquired();
+  if(!SyncNvidiaVsrFullscreen_Locked()) {
+    nvidia_vsr_presented_original_.reset();return original;
+  }
+  nvidia_vsr_presented_timestamp_ = original->timestamp();
+  nvidia_vsr_cache_->DiscardCompletedIf([&](const auto& ready) {
+    return ready->timestamp() < original->timestamp();
+  });
+  const uint64_t generation = nvidia_vsr_cache_->generation();
+  const uint64_t frame_id = original->unique_id().GetUnsafeValue();
+  auto selected = nvidia_vsr_cache_->Select(frame_id, original);
+  nvidia_vsr_presented_original_=selected!=original ? original : nullptr;
+  nvidia_vsr_presented_enhanced_id_=selected!=original ?
+      selected->unique_id().GetUnsafeValue() : 0;
+  nvidia_vsr_presented_epoch_=*nvidia_vsr_fullscreen_epoch_;
+  if (generation != nvidia_vsr_last_selected_generation_ ||
+      frame_id != nvidia_vsr_last_selected_frame_id_) {
+    nvidia_vsr_last_selected_generation_ = generation;
+    nvidia_vsr_last_selected_frame_id_ = frame_id;
+    const bool enhanced = selected != original;
+    if(nvidia_vsr_window_generation_ != generation) {
+      nvidia_vsr_window_generation_=generation;
+      nvidia_vsr_window_frames_=0;
+      nvidia_vsr_window_enhanced_=0;
+      nvidia_vsr_window_switches_=0;
+    }
+    if(nvidia_vsr_window_frames_ && enhanced != nvidia_vsr_previous_enhanced_)
+      ++nvidia_vsr_window_switches_;
+    nvidia_vsr_previous_enhanced_ = enhanced;
+    ++nvidia_vsr_presentations_;
+    ++nvidia_vsr_window_frames_;
+    if(enhanced) {
+      ++nvidia_vsr_selected_enhanced_;
+      ++nvidia_vsr_window_enhanced_;
+      if(nvidia_vsr_selected_enhanced_==1 || nvidia_vsr_selected_enhanced_%120==0)
+        MEDIA_LOG(INFO,media_log_) << "NVIDIA VSR selected_enhanced="
+            << nvidia_vsr_selected_enhanced_ << " generation=" << generation
+            << " frame_id=" << frame_id;
+    }
+    if(nvidia_vsr_window_frames_==120) {
+      MEDIA_LOG(INFO,media_log_) << "NVIDIA VSR presentation total="
+          << nvidia_vsr_presentations_ << " generation=" << generation
+          << " enhanced_window=" << nvidia_vsr_window_enhanced_
+          << " original_window=" << 120-nvidia_vsr_window_enhanced_
+          << " switches_window=" << nvidia_vsr_window_switches_;
+      nvidia_vsr_window_frames_=0;
+      nvidia_vsr_window_enhanced_=0;
+      nvidia_vsr_window_switches_=0;
+    }
+    task_runner_->PostTask(FROM_HERE,base::BindOnce(
+        &VideoRendererImpl::PumpNvidiaVsrFrames,weak_factory_.GetWeakPtr()));
+  }
+  return selected;
+}
+
+void VideoRendererImpl::OnNvidiaVsrDisconnected() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  base::AutoLock auto_lock(lock_);
+  nvidia_vsr_cache_->Invalidate();
+  nvidia_vsr_presented_original_.reset();
+  nvidia_vsr_presented_timestamp_.reset();
+}
+
+void VideoRendererImpl::OnNvidiaVsrCompleted(uint64_t generation,uint64_t frame_id,
+                                            scoped_refptr<VideoFrame> frame) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  base::AutoLock auto_lock(lock_);
+  if(!SyncNvidiaVsrFullscreen_Locked()) return;
+  if (nvidia_vsr_presented_timestamp_ &&
+      frame->timestamp() < *nvidia_vsr_presented_timestamp_)
+    return;
+  nvidia_vsr_cache_->Complete(generation,frame_id,std::move(frame));
+}
+
+void VideoRendererImpl::InvalidateNvidiaVsrConfig_Locked(bool encrypted_track) {
+  lock_.AssertAcquired();
+  // Config notification precedes old decoder drain. Once encrypted, bypass
+  // this renderer conservatively even after it changes back to a clear track.
+  nvidia_vsr_encrypted_seen_ |= encrypted_track;
+  nvidia_vsr_presented_original_.reset();
+  nvidia_vsr_cache_->Invalidate();
+  nvidia_vsr_presented_original_.reset();
+  nvidia_vsr_presented_timestamp_.reset();
+}
+
+bool VideoRendererImpl::IsNvidiaVsrFrameCandidate_Locked(uint64_t frame_id) const {
+  lock_.AssertAcquired();
+  auto found=nvidia_vsr_frame_generations_.find(frame_id);
+  return sink_ && (sink_->NvidiaVsrFullscreenEpoch() & 1) &&
+         !nvidia_vsr_encrypted_seen_ && found!=nvidia_vsr_frame_generations_.end() &&
+         found->second==nvidia_vsr_cache_->generation();
+}
+
+void VideoRendererImpl::OnNvidiaVsrFullscreenChanged() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  scoped_refptr<VideoFrame> original;
+  uint64_t enhanced_id=0,epoch=0;
+  {
+    base::AutoLock lock(lock_);
+    SyncNvidiaVsrFullscreen_Locked();
+    epoch=*nvidia_vsr_fullscreen_epoch_;
+    if(nvidia_vsr_presented_original_ && nvidia_vsr_presented_epoch_!=epoch) {
+      original=std::move(nvidia_vsr_presented_original_);
+      enhanced_id=nvidia_vsr_presented_enhanced_id_;
+    }
+  }
+  // Conditional installation on the compositor prevents a queued repaint
+  // from replacing a newer frame. Works paused and across rapid exit/reentry.
+  if(original && sink_)
+    sink_->PaintNvidiaVsrOriginal(std::move(original),enhanced_id,epoch);
+  PumpNvidiaVsrFrames();
+}
+
+bool VideoRendererImpl::SyncNvidiaVsrFullscreen_Locked() {
+  lock_.AssertAcquired();
+  const uint64_t epoch=sink_ ? sink_->NvidiaVsrFullscreenEpoch() : 0;
+  if(!nvidia_vsr_fullscreen_epoch_ || *nvidia_vsr_fullscreen_epoch_!=epoch) {
+    if(nvidia_vsr_fullscreen_epoch_) {
+      nvidia_vsr_cache_->Invalidate();
+      nvidia_vsr_presented_timestamp_.reset();
+      nvidia_vsr_frame_generations_.clear();
+    }
+    nvidia_vsr_fullscreen_epoch_=epoch;
+    MEDIA_LOG(INFO,media_log_) << "NVIDIA VSR fullscreen active=" << (epoch & 1)
+        << " epoch=" << epoch << " generation=" << nvidia_vsr_cache_->generation();
+  }
+  return epoch & 1;
+}
+
+void VideoRendererImpl::PumpNvidiaVsrFrames() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  base::AutoLock auto_lock(lock_);
+  if(!nvidia_vsr_client_ || !algorithm_ || !SyncNvidiaVsrFullscreen_Locked()) return;
+  std::set<uint64_t> queued;
+  algorithm_->VisitQueuedFrames(base::BindRepeating(
+      [](std::set<uint64_t>* ids,const scoped_refptr<VideoFrame>& frame) {
+        ids->insert(frame->unique_id().GetUnsafeValue());return false;
+      },base::Unretained(&queued)));
+  std::erase_if(nvidia_vsr_frame_generations_,[&](const auto& entry) {
+    return !queued.contains(entry.first);
+  });
+  // Borrow the renderer's existing queue; never retain another decoder FIFO.
+  // Frozen/current decisions cannot benefit from a late completion.
+  algorithm_->VisitQueuedFrames(base::BindRepeating(
+      [](VideoRendererImpl* self,const scoped_refptr<VideoFrame>& frame) {
+        if(!self->IsNvidiaVsrFrameCandidate_Locked(frame->unique_id().GetUnsafeValue()))
+          return false;
+        if(self->nvidia_vsr_presented_timestamp_ &&
+           frame->timestamp() <= *self->nvidia_vsr_presented_timestamp_) return false;
+        return self->nvidia_vsr_client_->Observe(frame,
+            self->nvidia_vsr_encrypted_seen_,
+            self->nvidia_vsr_cache_->generation());
+      },base::Unretained(this)));
 }
 
